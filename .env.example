# Identifies this station in cloud storage paths
# (<remote>/<STATION_NAME>/<year>/<doy>/) and container names, change it as needed.
STATION_NAME=station_name_01

PUID=1000
PGID=1000

# Host's dialout group GID — run `getent group dialout` on the host.
# Grants the container access to the GNSS receiver's serial device.
DIALOUT_GID=20

# Receiver baud rate= 460800 is a common default for u-blox boards
# configured for RAWX/SFRBX at high output rates; adjust to match your
# receiver's actual serial configuration.
GNSS_BAUD=460800

# Optional. Forces a specific RTKLIB stream format for non-u-blox
# receivers. leave unset for u-blox (auto-detected, the tested
# default). 
#Common values: "nov" (NovAtel OEM4/OEM6/OEM7/OEMStar),
# 				"sbf" (Septentrio). See docs/receiver-setup.md for details.
# GNSS_FORMAT=

# Optional. Enables the live web dashboard's NMEA feed. "shared" taps
# the same stream used for raw capture (no extra hardware port needed);
# "dedicated" uses a second serial port and also requires
# NMEA_DEVICE_PATH (e.g. /dev/gnss_nmea0) to be set below.
# Leave unset to disable the dashboard's live feed entirely.
# NMEA_SOURCE_MODE=shared
# NMEA_INTERNAL_PORT=5015
# NMEA_DEVICE_PATH=

# Two independent rclone remotes for redundant, parallel upload of raw
# and RINEX files. Each value must match a remote name defined in your
# rclone.conf, in the form "remotename:bucket-name" — for example
# "b2:my-bucket" or "s3:my-bucket". These can point to any rclone
# backend (Backblaze B2, S3-compatible storage, Azure Blob, Google
# Cloud Storage, etc.) — the names below are just placeholders, not a
# requirement to use those specific providers. Order doesn't matter:
# both remotes are treated as equal, redundant copies, not a
# primary/fallback pair.
REMOTE_STORAGE_1=remote1:your-bucket-name
REMOTE_STORAGE_2=remote2:your-bucket-name

# Local directory for raw/rinex/logs, relative to the project root.
DATA_DIR=./data

# Path to your rclone config file, relative to the project root. This
# file contains credentials — it's git-ignored by default and must
# never be committed. See the README for setup instructions.
RCLONE_CONFIG=./rclone.conf

# Optional. Enables authentication on the web dashboard. Defaults to
# false (no auth), fine on a trusted local network, but set to true
# plus a reverse proxy/basic-auth if the dashboard is ever reachable
# beyond that. See docs/host-setup.md.
# WEB_AUTH_ENABLED=false

# Optional. Baud rate for the dedicated NMEA serial port (only used
# when NMEA_SOURCE_MODE=dedicated). Defaults to 9600, a common NMEA
# default — but check your receiver's actual configuration, since
# this is independent of GNSS_BAUD (the main raw-capture port).
# NMEA_BAUD=9600
