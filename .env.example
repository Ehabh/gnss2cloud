PUID=1000
PGID=1000

# Host's dialout group GID — run `getent group dialout` on the host.
# Grants the container access to the GNSS receiver's serial device.
DIALOUT_GID=20

# Receiver baud rate= 460800 is a common default for u-blox boards
# configured for RAWX/SFRBX at high output rates; adjust to match your
# receiver's actual serial configuration.
GNSS_BAUD=460800

# Two independent rclone remotes for redundant, parallel upload of raw
# and RINEX files. Each value must match a remote name defined in your
# rclone.conf, in the form "remotename:bucket-name" — for example
# "b2:my-bucket" or "s3:my-bucket". These can point to any rclone
# backend (Backblaze B2, S3-compatible storage, Azure Blob, Google
# Cloud Storage, etc.) — the names below are just placeholders, not a
# requirement to use those specific providers. Order doesn't matter:
# both remotes are treated as equal, redundant copies, not a
# primary/fallback pair.
REMOTE_STORAGE_1=remote1:your-bucket-name
REMOTE_STORAGE_2=remote2:your-bucket-name

# Local directory for raw/rinex/logs, relative to the project root.
DATA_DIR=./data

# Path to your rclone config file, relative to the project root. This
# file contains credentials — it's git-ignored by default and must
# never be committed. See the README for setup instructions.
RCLONE_CONFIG=./rclone.conf
